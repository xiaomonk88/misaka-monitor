# ===== Misaka 监控 · 环境变量示例 =====
# 复制为 .env 并按需修改（一键安装脚本会自动生成）。Docker 部署时由 docker-compose 读取。

# 管理员账号：首次启动自动创建 admin / admin，首次登录必须修改密码（不在这里配置）。
# 忘记密码：docker compose exec misaka-monitor python -m app.reset_admin

# 会话签名密钥（务必改成随机长字符串！可用: python -c "import secrets;print(secrets.token_hex(32))"）
APP_SECRET_KEY=please-change-this-to-a-random-secret

# ---- Docker ----
# 对外访问端口（宿主机端口），访问 http://服务器IP:端口
MISAKA_PORT=8000
# 镜像版本：latest = 最新发布版；也可锁定为具体版本号，如 1.0.0
MISAKA_VERSION=latest

# ---- 应用 ----
# 显示时区（数据库内部统一存 UTC，仅展示时换算）
DISPLAY_TZ=Asia/Shanghai

# 全局目录同步间隔（小时）—— 新区域/新规格/参数变更检测。默认 24h
CATALOG_SYNC_HOURS=24

# 轮询礼貌性：单任务最小间隔（秒），防止过于频繁被风控
MIN_INTERVAL_SECONDS=15

# Misaka API 基地址（一般无需修改）
MISAKA_API_BASE=https://app.misaka.io/api

# 数据目录：本地开发用 ./data；Docker 中固定为 /data（由 docker-compose 覆盖）
DATA_DIR=./data
